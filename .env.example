# ============================================================================
# Sanic-Admin 环境变量样例
#
# 使用方法：
#   1) cp .env.example .env
#   2) 把本文件中所有 change-me-* 占位符替换成你自己的真实值
#   3) docker compose up -d --build
#
# 重要提示：
#   * 本文件中的 change-me-* 只是占位符，不是可用密钥；不修改直接启动，
#     production 环境会因 fail-closed 校验失败而拒绝启动（这是预期行为）。
#   * 本文件不含任何真实密钥，切勿把真实 .env 提交到版本库（.gitignore 已忽略 .env）。
#   * .env 由 docker compose 以 env_file 方式注入容器，镜像内不含任何密钥。
#   * 值中如需出现 "$" 字面量，请写成 "$$"（compose 会做变量插值）。
#   * JWT 私钥为多行 PEM，.env 中请用字面量 "\n" 表示换行；
#     app/config.py 的 load_jwt_keys 会把 "\n" 还原成真实换行后再解析。
# ============================================================================


# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------

# 环境名，可选 development / testing / production。
# Docker 镜像内固定为 production（fail-closed：缺失密钥直接退出）。
SANIC_ENV=production

# 应用监听地址。容器内必须为 0.0.0.0，否则宿主机映射进来的请求无法访问。
HOST=0.0.0.0

# 应用监听端口（容器内）。宿主机通过 22230 映射到本端口。
PORT=22222


# ---------------------------------------------------------------------------
# 密钥
#
# production 环境真正必填的是两个：JWT_PRIVATE_KEY 与 INITIAL_ADMIN_PASSWORD。
# 缺失任一个，进程直接退出（fail-closed）。
#
# SECRET_KEY 与 PASSWORD_SALT 当前**不参与任何签名或加密**：
#   * JWT 实际用 RS256 私钥（见下 JWT_PRIVATE_KEY）；
#   * 口令哈希用 argon2 自带随机盐。
# 因此它们是可选的，留空即可；填了也不会增强安全性。
# ---------------------------------------------------------------------------

# 应用密钥。可选，当前实现中不参与签名或加密。
# 若启用需要它的功能再填。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 口令盐。可选，当前实现中不参与口令哈希（argon2 自带随机盐）。
# 生成方式：python -c "import secrets; print(secrets.token_hex(16))"
PASSWORD_SALT=

# RS256 JWT 签名私钥（PEM）。production 环境必填，缺失即拒绝启动。
# 生成方式（生成后把内容整行写入下一行）：
#   openssl genrsa 2048 2>/dev/null | sed ':a;N;$!ba;s/\n/\\n/g' > /tmp/jwt_private_oneline.pem
#   cat /tmp/jwt_private_oneline.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me-generate-a-real-rsa-private-key-with-openssl-genrsa-2048\n-----END PRIVATE KEY-----"

# RS256 JWT 签名公钥（PEM）。可选；留空时由 app/config.py 从私钥自动推导。
# 若显式提供，必须与上面的私钥配对，否则启动失败。
JWT_PUBLIC_KEY=

# 初始管理员口令。production 环境必填，长度需在 8~128 字符之间。
# 缺失即拒绝启动。该账户仅在库中尚无管理员时创建，用于首次登录后立即修改。
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# 初始管理员账号（邮箱）。默认 SAdmin@Sanic.com。
INITIAL_ADMIN_EMAIL=SAdmin@Sanic.com


# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------

# 完整数据库 URL。留空时按下面的 DB_* 分项拼装（仅 production 会走拼装逻辑）。
#
# 开箱即用的 SQLite（容器内绝对路径，数据落在 app-data volume）：
DATABASE_URL=sqlite:///app/data/sanic_admin.sqlite3
#
# 若改用 MySQL，把上一行替换为下面这种形式。
# 默认使用 SQLite；若改用 MySQL，需自行提供驱动（如 asyncmy / pymysql），本镜像不内置：
# DATABASE_URL=mysql://sa_user:change-me-to-a-real-db-password@mysql-host:3306/sanic_admin?charset=utf8mb4
#
# MySQL 分项（仅在 DATABASE_URL 留空时用于拼装连接串）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-to-a-real-db-password
DB_NAME=sanic_admin


# ---------------------------------------------------------------------------
# 缓存
# ---------------------------------------------------------------------------

# 缓存后端，可选 memory / redis。
#   memory：进程内缓存，零依赖，单容器一键运行的默认值。
#   redis ：使用 redis 后端；此时必须启用 redis 服务
#            （docker compose --profile redis up -d），否则 production 会拒绝启动。
CACHE_TYPE=memory

# Redis 连接参数（CACHE_TYPE=redis 时生效）。
# REDIS_HOST 在 compose 内为服务名 "redis"；容器内 REDIS_PORT 是 6379，
# 宿主机映射到 22232（映射端口只影响宿主机侧访问）。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Redis 访问口令；compose 的 redis 服务默认不带口令，留空即可。
REDIS_PASSWORD=


# ---------------------------------------------------------------------------
# 邮件（用于验证码/账号激活等场景，不使用可留空）
# ---------------------------------------------------------------------------

# SMTP 服务器地址。
MAIL_SERVER=smtp.example.com
# SMTP 服务器端口。
MAIL_PORT=587
# 是否启用 STARTTLS（true/false）。
MAIL_USE_TLS=True
# SMTP 账号。
MAIL_USERNAME=change-me-to-your-smtp-username
# SMTP 口令或授权码。
MAIL_PASSWORD=change-me-to-your-smtp-password
# 发件人地址。
MAIL_DEFAULT_SENDER=change-me-to-your-smtp-username


# ---------------------------------------------------------------------------
# 管理界面（AMIS）
# ---------------------------------------------------------------------------

# AMIS 管理界面的静态资源目录。M1 起由后端同源托管，浏览器直接访问
# http://127.0.0.1:22222/amis/login.html 即可登录，与 API 同源，
# 不涉及 CORS，session Cookie 由浏览器自动携带。
#
# 留空或指向不存在的目录则不挂载管理界面（生产环境可据此关闭 AMIS）。
#
# 默认值是 <项目根>/amis（由 BASE_DIR 推导），一般无需改动。
# 下面这个值适用于 Docker 容器内（镜像把仓库复制到 /app）。
AMIS_DIR=/app/amis


# ---------------------------------------------------------------------------
# 跨域
# ---------------------------------------------------------------------------

# 允许的跨域来源，英文逗号分隔。production 默认不允许任何来源（空列表）。
# 示例：http://localhost:8080,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8080
