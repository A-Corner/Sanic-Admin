{
  "type": "page",
  "id": "dashboard",
  "title": "仪表盘",
  "initApi": {
    "method": "get",
    "url": "/api/v1/dashboard/summary",
    "dataType": "json",
    "adaptor": "return { status: payload.success ? 0 : 1, msg: payload.message, data: payload.data }"
  },
  "body": [
    {
      "type": "panel",
      "title": "系统概览",
      "body": [
        {
          "type": "flex",
          "className": "p-1",
          "items": [
            {
              "type": "container",
              "size": "xs",
              "body": [
                {
                  "type": "card",
                  "header": {
                    "title": "账户总数",
                    "subTitle": "已验证 / 管理员"
                  },
                  "body": [
                    {
                      "type": "tpl",
                      "tpl": "<div style=\"font-size:28px;font-weight:600\">${accounts.total | default:0}</div>"
                    },
                    {
                      "type": "tpl",
                      "tpl": "<div>活跃账户：${accounts.active | default:0}　管理员：${accounts.admin | default:0}</div>"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "size": "xs",
              "body": [
                {
                  "type": "card",
                  "header": {
                    "title": "角色总数",
                    "subTitle": "权限组数量"
                  },
                  "body": [
                    {
                      "type": "tpl",
                      "tpl": "<div style=\"font-size:28px;font-weight:600\">${roles.total | default:0}</div>"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "size": "xs",
              "body": [
                {
                  "type": "card",
                  "header": {
                    "title": "文件存储",
                    "subTitle": "上传文件统计"
                  },
                  "body": [
                    {
                      "type": "tpl",
                      "tpl": "<div style=\"font-size:28px;font-weight:600\">${files.total | default:0}</div>"
                    },
                    {
                      "type": "tpl",
                      "tpl": "<div>占用空间：${files.storage_formatted | default:'0 B'}</div>"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "size": "xs",
              "body": [
                {
                  "type": "card",
                  "header": {
                    "title": "系统资源",
                    "subTitle": "运行状态"
                  },
                  "body": [
                    {
                      "type": "tpl",
                      "tpl": "<div>操作系统：${system.os | default:'未知'}</div>"
                    },
                    {
                      "type": "tpl",
                      "tpl": "<div>CPU：${system.cpu_usage | default:0}%</div>"
                    },
                    {
                      "type": "tpl",
                      "tpl": "<div>内存：${system.memory.percent | default:0}%　磁盘：${system.disk.percent | default:0}%</div>"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "panel",
      "title": "快捷入口",
      "body": [
        {
          "type": "button-group",
          "buttons": [
            {
              "type": "button",
              "label": "账户列表",
              "actionType": "link",
              "link": "/account/list"
            },
            {
              "type": "button",
              "label": "角色列表",
              "actionType": "link",
              "link": "/role/list"
            },
            {
              "type": "button",
              "label": "操作日志",
              "actionType": "link",
              "link": "/log/list"
            }
          ]
        }
      ]
    }
  ]
}
